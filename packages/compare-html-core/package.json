{
  "name": "@compare-html/core",
  "license": "MIT",
  "version": "0.1.1",
  "description": "Core HTML comparison library",
  "keywords": [
    "compare html",
    "html comparison",
    "html diff"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unitstack/compare-html.git",
    "directory": "packages/compare-html-core"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "lint": "eslint",
    "test": "npm run test-type && npm run test-coverage",
    "test-type": "tsc --noEmit",
    "test-unit": "vitest run",
    "test-coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "parse5": "^7.2.1"
  },
  "devDependencies": {
    "@compare-html/eslint-config": "workspace:*",
    "@compare-html/tsconfig": "workspace:*",
    "@rslib/core": "^0.21.5",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
