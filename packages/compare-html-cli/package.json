{
  "name": "@compare-html/cli",
  "license": "MIT",
  "version": "0.1.0",
  "description": "HTML comparison Command Line Tool",
  "keywords": [
    "compare html",
    "html comparison",
    "html diff"
  ],
  "bin": {
    "compare-html": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "lint": "eslint",
    "test": "npm run test-type && npm run test-coverage && npm run test-e2e",
    "test-type": "tsc --noEmit",
    "test-unit": "vitest run src",
    "test-coverage": "vitest run src --coverage",
    "test-e2e": "vitest run e2e",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@compare-html/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "commander": "^14.0.3",
    "package-directory": "^8.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@compare-html/eslint-config": "workspace:*",
    "@compare-html/tsconfig": "workspace:*",
    "@rslib/core": "^0.21.5",
    "@types/commander": "^2.12.5",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
